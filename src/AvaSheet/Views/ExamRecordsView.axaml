<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaSheet.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="620"
             x:Class="AvaSheet.Views.ExamRecordsView"
             x:DataType="vm:ExamRecordsViewModel">

    <Design.DataContext>
        <vm:ExamRecordsViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,22,32,16" RowDefinitions="Auto,Auto,*" RowSpacing="16">

            <!-- 头部 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Button Theme="{StaticResource IconButtonTheme}"
                        Command="{Binding GoBackCommand}"
                        VerticalAlignment="Top">
                    <PathIcon Data="{StaticResource IconBack}" Width="16" Height="16" />
                </Button>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Classes="h1" Text="{Binding Title}" />
                    <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2"
                        Theme="{StaticResource DangerLinkButtonTheme}"
                        Content="清空记录"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasRecords}"
                        Command="{Binding ClearAllCommand}" />
            </Grid>

            <!-- 汇总 -->
            <Border Grid.Row="1" Classes="formPanel" Padding="20,16" IsVisible="{Binding HasRecords}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="statLabel" Text="考试次数" />
                        <TextBlock Classes="statValue" Text="{Binding CountText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="statLabel" Text="平均正确率" />
                        <TextBlock Classes="statValue" Text="{Binding AverageText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="statLabel" Text="最近一次" />
                        <TextBlock Classes="statValue" Text="{Binding RecentText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 记录列表 -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding Records}"
                          IsVisible="{Binding HasRecords}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExamRecordRowViewModel">
                        <Border Classes="formPanel" Padding="18,15" Margin="0,0,0,10">
                            <StackPanel Spacing="12">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DateText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Classes="pill">
                                                <TextBlock Classes="pillText" Text="{Binding BankName}" />
                                            </Border>
                                            <Border Classes="pillWarn" IsVisible="{Binding HasNote}">
                                                <TextBlock Classes="pillWarnText" Text="{Binding NoteText}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Classes="small" Text="{Binding MetaText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="18"
                                                VerticalAlignment="Center">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Classes="statValue" Text="{Binding ScoreText}" />
                                                <TextBlock Classes="small"
                                                           Text="{Binding ScoreTotalText}"
                                                           VerticalAlignment="Bottom"
                                                           Margin="0,0,0,4" />
                                            </StackPanel>
                                            <TextBlock Classes="small"
                                                       Text="{Binding AccuracyText}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                            <Button Theme="{StaticResource LinkButtonTheme}"
                                                    Content="{Binding ExpandText}"
                                                    Command="{Binding ToggleCommand}" />
                                            <Button Theme="{StaticResource DangerLinkButtonTheme}"
                                                    Content="删除"
                                                    Command="{Binding DeleteCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 逐题作答 -->
                                <StackPanel Spacing="0" IsVisible="{Binding IsExpanded}">
                                    <Border Height="1"
                                            Background="{DynamicResource DividerBrush}"
                                            Margin="0,0,0,2" />

                                    <ItemsControl ItemsSource="{Binding Answers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ExamRecordAnswerViewModel">
                                                <Border Classes="reviewRow">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Number}"
                                                                   FontSize="12"
                                                                   Width="22"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Top"
                                                                   Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}" />

                                                        <StackPanel Grid.Column="1" Spacing="5">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border Classes="reviewBadge"
                                                                        Classes.ok="{Binding IsCorrect}"
                                                                        Classes.bad="{Binding IsWrong}"
                                                                        Classes.skipped="{Binding IsSkipped}">
                                                                    <TextBlock Text="{Binding ResultText}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                                <TextBlock Classes="small"
                                                                           Text="{Binding TypeShort}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Classes="small"
                                                                           Text="{Binding ScoreText}"
                                                                           IsVisible="{Binding HasScore}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding Stem}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="21"
                                                                       Foreground="{DynamicResource AppForegroundBrush}" />

                                                            <TextBlock Classes="small" Text="{Binding YourAnswerText}" />
                                                            <TextBlock Classes="small"
                                                                       Text="{Binding CorrectAnswerText}"
                                                                       Foreground="{DynamicResource SuccessBrush}" />
                                                            <TextBlock Classes="muted"
                                                                       Text="{Binding ExplanationText}"
                                                                       IsVisible="{Binding HasExplanation}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="20"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 空状态 -->
            <Border Grid.Row="1"
                    Grid.RowSpan="2"
                    Classes="emptyPanel"
                    MaxWidth="620"
                    Margin="0,24,0,0"
                    VerticalAlignment="Top"
                    IsVisible="{Binding IsEmpty}">
                <StackPanel Spacing="10">
                    <Border Classes="iconTile" HorizontalAlignment="Left">
                        <PathIcon Data="{StaticResource IconHistory}"
                                  Width="22" Height="22"
                                  Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <TextBlock Classes="cardTitle" Text="还没有考试记录" Margin="0,6,0,0" />
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="交卷后的成绩会自动记录在这里。" />
                    <Button Classes="accent"
                            Content="去模拟考试"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            Command="{Binding OpenExamCommand}" />
                </StackPanel>
            </Border>

            <!-- 错误提示 -->
            <Border Grid.Row="2"
                    Classes="notice"
                    VerticalAlignment="Bottom"
                    IsVisible="{Binding HasError}">
                <TextBlock Classes="noticeText" Text="{Binding ErrorMessage}" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
