<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaSheet.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="190"
        x:Class="AvaSheet.Views.NameInputWindow"
        x:DataType="vm:NameInputViewModel"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <StackPanel Margin="24" Spacing="14">

        <TextBlock Classes="muted" Text="{Binding Label}" />

        <TextBox x:Name="InputBox"
                 Text="{Binding Value, Mode=TwoWay}"
                 PlaceholderText="{Binding Placeholder}"
                 MaxLength="60" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,4,0,0">
            <Button Content="取消" Click="OnCancel" MinWidth="84" />
            <Button Classes="accent"
                    Content="{Binding ConfirmText}"
                    Click="OnConfirm"
                    IsEnabled="{Binding CanConfirm}"
                    MinWidth="84" />
        </StackPanel>
    </StackPanel>
</Window>
