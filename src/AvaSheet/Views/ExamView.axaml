<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaSheet.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="620"
             x:Class="AvaSheet.Views.ExamView"
             x:DataType="vm:ExamViewModel">

    <Design.DataContext>
        <vm:ExamViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="32,22,32,16" RowSpacing="14">

        <!-- 头部：作答与回顾时隐藏，页面上不再显示「当前处于什么模式」 -->
        <StackPanel Grid.Row="0" Spacing="8" IsVisible="{Binding ShowPageHeader}">
            <Button Theme="{StaticResource LinkButtonTheme}"
                    Command="{Binding LeaveCommand}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconBack}" Width="13" Height="13" />
                    <TextBlock Text="返回首页" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="{Binding Title}" />
                <Border Classes="pill" VerticalAlignment="Center">
                    <TextBlock Classes="pillText" Text="{Binding BankName}" />
                </Border>
            </StackPanel>

            <TextBlock Classes="small" Text="{Binding Description}" />

            <Border Classes="notice" IsVisible="{Binding HasError}" Margin="0,2,0,0">
                <TextBlock Classes="noticeText" Text="{Binding ErrorMessage}" />
            </Border>
        </StackPanel>

        <!-- 内容 -->
        <Grid Grid.Row="1">

            <!-- 加载中 -->
            <TextBlock Classes="muted"
                       Text="正在加载题库…"
                       HorizontalAlignment="Center"
                       Margin="0,60,0,0"
                       IsVisible="{Binding IsLoading}" />

            <!-- 没有题目 -->
            <Border Classes="emptyPanel"
                    MaxWidth="620"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    IsVisible="{Binding IsEmpty}">
                <StackPanel Spacing="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Classes="cardTitle" Text="这里还组不出一份卷子" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted"
                               Text="先去「管理题目」添加几道题。"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="420" />
                    <Button Classes="accent"
                            Content="返回首页"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Command="{Binding LeaveCommand}" />
                </StackPanel>
            </Border>

            <!-- 组卷设置 -->
            <ScrollViewer IsVisible="{Binding IsConfig}"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="700"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                    <Border Classes="formPanel" Padding="22">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="fieldLabel" Text="题型题量" />
                            <Grid ColumnDefinitions="Auto,*,104,112"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="6"
                                  ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Classes="small" Text="题量"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="3"
                                           Classes="small" Text="每题分值（分）"
                                           HorizontalAlignment="Center" />

                                <CheckBox Grid.Row="1" Grid.Column="0"
                                          IsChecked="{Binding SingleEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding SingleHasQuestions}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="取消勾选就不从这一题型抽题。" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding SingleLabel}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="1" Grid.Column="2"
                                               Value="{Binding SingleCountValue, Mode=TwoWay}"
                                               IsEnabled="{Binding SingleEnabled}"
                                               Minimum="0"
                                               Maximum="{Binding SingleAvailable}"
                                               Increment="1"
                                               FormatString="0" />
                                <NumericUpDown Grid.Row="1" Grid.Column="3"
                                               Value="{Binding SingleScoreValue, Mode=TwoWay}"
                                               IsEnabled="{Binding SingleEnabled}"
                                               Minimum="0.5"
                                               Maximum="100"
                                               Increment="0.5"
                                               FormatString="0.0#" />

                                <CheckBox Grid.Row="2" Grid.Column="0"
                                          IsChecked="{Binding MultipleEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding MultipleHasQuestions}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="取消勾选就不从这一题型抽题。" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding MultipleLabel}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="2" Grid.Column="2"
                                               Value="{Binding MultipleCountValue, Mode=TwoWay}"
                                               IsEnabled="{Binding MultipleEnabled}"
                                               Minimum="0"
                                               Maximum="{Binding MultipleAvailable}"
                                               Increment="1"
                                               FormatString="0" />
                                <NumericUpDown Grid.Row="2" Grid.Column="3"
                                               Value="{Binding MultipleScoreValue, Mode=TwoWay}"
                                               IsEnabled="{Binding MultipleEnabled}"
                                               Minimum="0.5"
                                               Maximum="100"
                                               Increment="0.5"
                                               FormatString="0.0#" />

                                <CheckBox Grid.Row="3" Grid.Column="0"
                                          IsChecked="{Binding TrueFalseEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding TrueFalseHasQuestions}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="取消勾选就不从这一题型抽题。" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding TrueFalseLabel}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="3" Grid.Column="2"
                                               Value="{Binding TrueFalseCountValue, Mode=TwoWay}"
                                               IsEnabled="{Binding TrueFalseEnabled}"
                                               Minimum="0"
                                               Maximum="{Binding TrueFalseAvailable}"
                                               Increment="1"
                                               FormatString="0" />
                                <NumericUpDown Grid.Row="3" Grid.Column="3"
                                               Value="{Binding TrueFalseScoreValue, Mode=TwoWay}"
                                               IsEnabled="{Binding TrueFalseEnabled}"
                                               Minimum="0.5"
                                               Maximum="100"
                                               Increment="0.5"
                                               FormatString="0.0#" />
                            </Grid>

                            <Border Height="1"
                                    Background="{DynamicResource DividerBrush}"
                                    Margin="0,6" />

                            <TextBlock Classes="fieldLabel" Text="限时" />
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <NumericUpDown Grid.Column="0"
                                               Width="120"
                                               Value="{Binding LimitMinutesValue, Mode=TwoWay}"
                                               Minimum="1"
                                               Maximum="600"
                                               Increment="1"
                                               FormatString="0" />
                                <TextBlock Grid.Column="1"
                                           Classes="small"
                                           Text="分钟"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1"
                                    Background="{DynamicResource DividerBrush}"
                                    Margin="0,6" />

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Classes="muted"
                                           Text="{Binding PaperTotalsText}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="accent"
                                        Content="开始考试"
                                        Command="{Binding StartCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 作答与回顾：沉浸式，顶栏由主窗口收起；布局与练习页共用 -->
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="12"
                  IsVisible="{Binding ShowAnswerLayout}">

                <!-- 作答页自己的细顶栏：退出 + 卷面信息 -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <Panel Grid.Column="0" HorizontalAlignment="Left">
                        <Button Theme="{StaticResource LinkButtonTheme}"
                                Command="{Binding LeaveCommand}"
                                IsVisible="{Binding IsRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconBack}" Width="13" Height="13" />
                                <TextBlock Text="退出考试" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Theme="{StaticResource LinkButtonTheme}"
                                Command="{Binding LeaveCommand}"
                                IsVisible="{Binding IsFinished}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconBack}" Width="13" Height="13" />
                                <TextBlock Text="返回首页" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Panel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border Classes="pill">
                            <TextBlock Classes="pillText" Text="{Binding BankName}" />
                        </Border>
                        <Border Classes="pill">
                            <TextBlock Classes="pillText" Text="{Binding PaperSizeText}" />
                        </Border>
                        <Border Classes="pill" IsVisible="{Binding IsFinished}">
                            <TextBlock Classes="pillText" Text="已交卷" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,240" ColumnSpacing="16">

                <Border Grid.Column="0" Classes="formPanel" Padding="22">
                    <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Classes="typeBadge">
                                        <TextBlock Classes="typeBadgeText" Text="{Binding Current.TypeShort}" />
                                    </Border>
                                    <TextBlock Classes="small"
                                               Text="{Binding Current.DifficultyStars}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Classes="small"
                                               Text="{Binding Current.ScoreText}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0" />
                                    <TextBlock Classes="small"
                                               Text="{Binding Current.TagsText}"
                                               IsVisible="{Binding Current.HasTags}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding Current.Stem}"
                                           TextWrapping="Wrap"
                                           FontSize="17"
                                           LineHeight="26"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           Margin="0,8,0,2" />

                                <ItemsControl ItemsSource="{Binding Current.Options}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExamOptionViewModel">
                                            <Button Classes="optionRow"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Classes.correct="{Binding IsCorrectAnswer}"
                                                    Classes.wrong="{Binding IsWrongPick}"
                                                    Command="{Binding SelectCommand}"
                                                    IsHitTestVisible="{Binding IsActive}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left"
                                                            Classes="optionKey"
                                                            Margin="0,0,12,0"
                                                            IsVisible="{Binding HasKey}">
                                                        <TextBlock Classes="optionKeyText" Text="{Binding KeyText}" />
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="✓"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               IsVisible="{Binding ShowCheck}" />
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="✗"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               IsVisible="{Binding IsWrongPick}" />
                                                    <TextBlock Classes="optionText"
                                                               Text="{Binding Text}"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Classes="small"
                                           Text="多选题要全部选对才得分。"
                                           Margin="0,6,0,0"
                                           IsVisible="{Binding Current.ShowMultipleHint}" />

                                <!-- 交卷后：本题的对错、正确答案与解析 -->
                                <Border Classes="resultBanner"
                                        Classes.ok="{Binding Current.IsCorrect}"
                                        Classes.bad="{Binding !Current.IsCorrect}"
                                        Classes.skipped="{Binding !Current.IsAnswered}"
                                        Margin="0,10,0,0"
                                        IsVisible="{Binding IsFinished}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="resultTitle"
                                                   Classes.ok="{Binding Current.IsCorrect}"
                                                   Classes.bad="{Binding !Current.IsCorrect}"
                                                   Classes.skipped="{Binding !Current.IsAnswered}"
                                                   Text="{Binding Current.ResultTitle}" />
                                        <TextBlock Classes="muted"
                                                   Text="{Binding Current.ResultDetail}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Classes="muted"
                                                   Text="{Binding Current.ExplanationDisplay}"
                                                   IsVisible="{Binding Current.HasExplanation}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="notice"
                                        Margin="0,10,0,0"
                                        IsVisible="{Binding HasError}">
                                    <TextBlock Classes="noticeText" Text="{Binding ErrorMessage}" />
                                </Border>
                            </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                        <Button Grid.Column="0"
                                Content="上一题"
                                Command="{Binding PreviousCommand}"
                                IsEnabled="{Binding !IsFirstQuestion}" />
                        <TextBlock Grid.Column="1"
                                   Classes="small"
                                   Text="{Binding ProgressText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Classes="accent"
                                Content="下一题"
                                Command="{Binding NextCommand}"
                                IsEnabled="{Binding !IsLastQuestion}" />
                    </Grid>
                    </Grid>
                </Border>

                <!-- 右侧：作答时是计时 + 交卷，交卷后是成绩 + 回顾 -->
                <Border Grid.Column="1" Classes="formPanel" Padding="16" VerticalAlignment="Top">
                    <StackPanel Spacing="8">

                        <!-- 作答中：计时 -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsRunning}">
                            <TextBlock Classes="small" Text="剩余时间" />
                            <TextBlock Classes="countdown"
                                       Classes.low="{Binding IsTimeLow}"
                                       Text="{Binding RemainingText}" />
                        </StackPanel>

                        <!-- 交卷后：本次成绩 -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsFinished}">
                            <TextBlock Classes="small" Text="本次成绩" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding ScoreText}"
                                           FontSize="34"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Classes="muted"
                                           Text="{Binding ScoreTotalText}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,17" />
                            </StackPanel>

                            <TextBlock Classes="small"
                                       Text="{Binding ScoreSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Height="1"
                                Background="{DynamicResource DividerBrush}"
                                Margin="0,8" />

                        <!-- 答题卡两种状态共用：交卷前的对错标记恒为 false，样式不生效 -->
                        <TextBlock Classes="small" Text="答题卡" />
                        <ItemsControl ItemsSource="{Binding Navigator}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExamNavigatorItemViewModel">
                                    <Button Classes="navChip"
                                            Classes.current="{Binding IsCurrent}"
                                            Classes.answered="{Binding IsAnswered}"
                                            Classes.ok="{Binding IsCorrect}"
                                            Classes.bad="{Binding IsWrong}"
                                            Content="{Binding Number}"
                                            Command="{Binding JumpCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="small"
                                   Text="{Binding AnsweredText}"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding IsRunning}" />

                        <Border Height="1"
                                Background="{DynamicResource DividerBrush}"
                                Margin="0,8" />

                        <!-- 作答中：交卷 -->
                        <Button Classes="accent"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Content="交卷"
                                Command="{Binding SubmitCommand}"
                                IsVisible="{Binding IsRunning}" />

                        <!-- 交卷后：重看成绩、再考一次 -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsFinished}">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Content="查看成绩"
                                    Command="{Binding ShowResultCommand}" />

                            <Button Classes="accent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Content="再考一次"
                                    Command="{Binding RestartCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
