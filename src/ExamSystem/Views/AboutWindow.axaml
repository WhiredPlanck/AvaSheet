<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="300"
        x:Class="ExamSystem.Views.AboutWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="关于"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <StackPanel Margin="28,26,28,24"
                MinWidth="300"
                HorizontalAlignment="Center">

        <Border Width="64" Height="64"
                CornerRadius="18"
                Background="{DynamicResource AccentBrush}"
                HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource IconLogo}"
                      Width="34" Height="34"
                      Foreground="White" />
        </Border>

        <TextBlock Text="ExamSystem"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,0" />

        <TextBlock x:Name="VersionLabel"
                   Classes="small"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" />

        <Button Content="关闭"
                Classes="accent"
                MinWidth="88"
                HorizontalAlignment="Center"
                Margin="0,22,0,0"
                Click="OnClose" />
    </StackPanel>
</Window>
