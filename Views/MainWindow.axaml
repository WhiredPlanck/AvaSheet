<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExamSystem.ViewModels"
        xmlns:svc="using:ExamSystem.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="ExamSystem.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ExamSystem"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- ============ 顶栏 ============ -->
        <Border DockPanel.Dock="Top" Classes="topbar" IsVisible="{Binding !IsImmersive}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="20,0">

                <Border Grid.Column="0"
                        Width="30" Height="30"
                        CornerRadius="9"
                        Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconLogo}"
                              Width="17" Height="17"
                              Foreground="White" />
                </Border>

                <TextBlock Grid.Column="1"
                           Classes="brand"
                           Text="ExamSystem"
                           Margin="10,0,0,0" />

                <!-- 当前题库 -->
                <ComboBox Grid.Column="2"
                          Classes="bankPicker"
                          Margin="28,0,0,0"
                          ItemsSource="{Binding Banks}"
                          SelectedItem="{Binding SelectedBank}"
                          PlaceholderText="暂无题库">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:BankSummary">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <Button Theme="{StaticResource IconButtonTheme}"
                            Command="{Binding OpenBankManagerCommand}"
                            ToolTip.Tip="管理题库">
                        <PathIcon Data="{StaticResource IconBank}" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <Button Grid.Column="4"
                        Theme="{StaticResource IconButtonTheme}"
                        Content="⋯"
                        FontSize="18"
                        VerticalAlignment="Center">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{Binding HardwareAccelerationMenuText}"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding HardwareAcceleration, Mode=TwoWay}"
                                      ToolTip.Tip="默认关闭，用软件渲染。开启后使用显卡加速，切换后需要重启程序。" />
                            <Separator />
                            <MenuItem Header="关于" Command="{Binding AboutCommand}" />
                            <Separator />
                            <MenuItem Header="退出" Command="{Binding ExitCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar" IsVisible="{Binding !IsImmersive}">
            <Grid ColumnDefinitions="*,Auto" Margin="20,0">
                <TextBlock Text="{Binding StatusText}"
                           Classes="small"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Classes="small"
                           Text="{Binding BankStatusText}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ============ 内容区：由 CurrentPage 决定，ViewLocator 负责找 View ============ -->
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
