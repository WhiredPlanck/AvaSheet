<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ExamSystem.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="620"
             x:Class="ExamSystem.Views.ExamView"
             x:DataType="vm:ExamViewModel">

    <Design.DataContext>
        <vm:ExamViewModel />
    </Design.DataContext>

    <StackPanel Margin="40,32">
        <Button Theme="{StaticResource LinkButtonTheme}"
                Command="{Binding GoBackCommand}"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconBack}" Width="13" Height="13" />
                <TextBlock Text="返回首页" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <TextBlock Classes="h1" Text="{Binding Title}" Margin="0,20,0,0" />
        <TextBlock Classes="muted" Text="{Binding Description}" Margin="0,8,0,0" />

        <Border Classes="emptyPanel" Margin="0,28,0,0">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="cardTitle" Text="该模块正在开发中" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="阶段 5 会在这里实现组卷、计时与评分。" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
