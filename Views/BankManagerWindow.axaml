<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExamSystem.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
        x:Class="ExamSystem.Views.BankManagerWindow"
        x:DataType="vm:BankManagerViewModel"
        Title="题库管理"
        Width="720"
        Height="520"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Styles>
        <!-- 列表行自己带卡片外观，容器只负责选中/悬停 -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,18">

        <!-- 头部 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="题库" />
                <TextBlock Classes="muted" Text="{Binding SummaryText}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Button Command="{Binding ImportCommand}" ToolTip.Tip="从 JSON 文件导入题库">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconImport}" Width="15" Height="15" />
                        <TextBlock Text="导入" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="accent" Command="{Binding CreateCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconPlus}" Width="15" Height="15" />
                        <TextBlock Text="新建题库" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 列表 / 空状态 -->
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Banks}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BankRowViewModel">
                        <Border Classes="bankRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="rowTitle" Text="{Binding Name}" />
                                        <Border Classes="pill" IsVisible="{Binding IsCurrent}">
                                            <TextBlock Classes="pillText" Text="当前" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Classes="small" Text="{Binding Meta}" />
                                </StackPanel>

                                <!-- 常规操作 -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding !IsConfirmingDelete}">
                                    <Button Theme="{StaticResource LinkButtonTheme}"
                                            Content="重命名"
                                            Command="{Binding RenameCommand}" />
                                    <Button Theme="{StaticResource LinkButtonTheme}"
                                            Content="导出"
                                            Command="{Binding ExportCommand}" />
                                    <Button Theme="{StaticResource DangerLinkButtonTheme}"
                                            Content="删除"
                                            Command="{Binding RequestDeleteCommand}" />
                                </StackPanel>

                                <!-- 删除确认 -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsConfirmingDelete}">
                                    <TextBlock Classes="small"
                                               Text="题目会一起删除"
                                               VerticalAlignment="Center" />
                                    <Button Content="取消" Command="{Binding CancelDeleteCommand}" />
                                    <Button Classes="accent"
                                            Content="确认删除"
                                            Command="{Binding ConfirmDeleteCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Classes="emptyPanel" IsVisible="{Binding !HasBanks}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Border Classes="iconTile" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconBook}"
                                  Width="20" Height="20"
                                  Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <TextBlock Classes="cardTitle"
                               Text="还没有题库"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                    <TextBlock Classes="muted"
                               Text="新建或导入一个题库。"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部：提示 + 关闭 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                <Border Classes="notice" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="noticeText" Text="{Binding ErrorMessage}" />
                </Border>
                <Border Classes="notice"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        IsVisible="{Binding WarningMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="noticeText"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Text="{Binding WarningMessage}" />
                </Border>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="关闭"
                    MinWidth="84"
                    VerticalAlignment="Bottom"
                    Click="OnClose" />
        </Grid>
    </Grid>
</Window>
