<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- 浅色（也是跟随系统且无法判定时的兜底） -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6FB" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E7F1" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#FAFBFF" />
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#171A23" />
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF0FF" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#B9BDF7" />
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#EEF0F6" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E3E7F1" />
            <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFF" />
            <BoxShadows x:Key="CardShadow">0 1 3 0 #14000000</BoxShadows>
            <BoxShadows x:Key="CardShadowHover">0 12 28 0 #244F46E5</BoxShadows>
        </ResourceDictionary>

        <!-- 深色 -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101219" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#171A23" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1D27" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#292D3B" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#151821" />
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#EDF0F7" />
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="#98A0B3" />
            <SolidColorBrush x:Key="AccentBrush" Color="#7C83F5" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#232645" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#4A4E9E" />
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#232734" />
            <SolidColorBrush x:Key="DividerBrush" Color="#292D3B" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#2A1618" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#FCA5A5" />
            <SolidColorBrush x:Key="DangerForegroundBrush" Color="#1A1D27" />
            <BoxShadows x:Key="CardShadow">0 1 3 0 #40000000</BoxShadows>
            <BoxShadows x:Key="CardShadowHover">0 12 28 0 #4D4F46E5</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 尺寸 -->
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">11</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusSmall">9</CornerRadius>
</ResourceDictionary>
