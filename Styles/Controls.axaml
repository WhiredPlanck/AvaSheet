<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 文本 ============ -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.brand">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.cardAction">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ============ 容器 ============ -->
    <Style Selector="Border.topbar">
        <Setter Property="Height" Value="56" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.statusbar">
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- 卡片里的图标底板 -->
    <Style Selector="Border.iconTile">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="{DynamicResource TileCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <!-- 占位面板 -->
    <Style Selector="Border.emptyPanel">
        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="MinHeight" Value="220" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <!-- 顶栏里的题库下拉框 -->
    <Style Selector="ComboBox.bankPicker">
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- ============ 题库列表 ============ -->
    <Style Selector="Border.bankRow">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource TileCornerRadius}" />
        <Setter Property="Padding" Value="16,13" />
    </Style>

    <Style Selector="TextBlock.rowTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 行内提示条：错误红、警告琥珀 -->
    <Style Selector="Border.notice">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadiusSmall}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    </Style>

    <Style Selector="TextBlock.noticeText">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- 小标签：当前题库 -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.pillText">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
</Styles>
